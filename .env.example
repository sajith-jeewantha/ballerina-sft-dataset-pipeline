# Copy to .env (gitignored) and fill in. Only secrets and model choices live here;
# everything else is in config/pipeline.yaml.

# --- LLM access (OpenAI-compatible endpoint; OpenRouter by default) ---
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Models (OpenRouter ids, e.g. qwen/..., anthropic/..., openai/...) ---
QUESTION_GEN_MODEL=
ANSWER_GEN_MODEL=
# Use a DIFFERENT model family from ANSWER_GEN_MODEL to avoid self-preference bias.
JUDGE_MODEL=

# sentence-transformers model id; its max_seq_length bounds chunk.max_tokens
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# --- Optional ---
GITHUB_TOKEN=
GCS_BUCKET=
