# Copy to .env (gitignored) and fill in. Secrets, model choices and run limits live here;
# everything else is in config/pipeline.yaml. Empty values are ignored.

# --- LLM access (OpenAI-compatible endpoint; OpenRouter by default) ---
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Models (OpenRouter ids, e.g. qwen/qwen3.8-flash, deepseek/deepseek-v4.1-flash) ---
QUESTION_GEN_MODEL=
ANSWER_GEN_MODEL=
# generate-prompts: the writer (default ANSWER_GEN_MODEL, the DeepSeek teacher) and the reviewer,
# which must be a different model family (default QUESTION_GEN_MODEL, e.g. qwen/qwen3.8-flash)
PROMPT_WRITER_MODEL=
JUDGE_MODEL=

# --- GitHub API (avoids rate limits: 60 requests/hour without a token, 5,000 with one).
# A fine-grained token with read-only access to public repositories is enough.
GITHUB_TOKEN=

# --- Run limits (printed at startup so you can confirm what will run) ---
LIMIT_GENERATING=10        # max questions (generate-questions) or prompts (generate-prompts) per run. 0 = no limit.
LIMIT_SCRAPE_PAGES=20      # max pages to download per source per run. 0 = no limit.
QUESTIONS_PER_CHUNK=3      # questions generated from each content chunk
REQUEST_DELAY_SECONDS=1    # polite delay between web/API requests
LIMIT_REPOS=20             # collect-repos: max repositories cloned per run. 0 = no limit.

# --- Storage (everything is always written to LOCAL_DATA_DIR; the bucket mirrors it) ---
STORAGE_BUCKET=false       # false = local only (testing, quality checks)
                           # true  = also upload each command's outputs to the bucket (same layout)
STORAGE_PROVIDER=gcs       # gcs | aws-s3   (local = BUCKET_NAME is a folder; for trying the layout)
BUCKET_NAME=               # e.g. ballerina-slm-data
BUCKET_PREFIX=             # optional sub-folder in the bucket, e.g. team-a/
LOCAL_DATA_DIR=./data
# GCS auth:  gcloud auth application-default login   (no key in .env)
#            install the client: pip install -e "shared[gcs]"
# AWS auth:  a profile from ~/.aws/credentials (no keys in .env)
#            install the client: pip install -e "shared[s3]"
# S3-compatible stores (e.g. Cloudflare R2): STORAGE_PROVIDER=aws-s3 plus S3_ENDPOINT_URL
AWS_PROFILE=
AWS_REGION=
S3_ENDPOINT_URL=
